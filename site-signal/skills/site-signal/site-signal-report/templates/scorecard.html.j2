<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Site Signal — scorecard — {{ ts }}</title>
<style>
  /* Self-contained: inline CSS only, no external fonts, scripts or images. */
  :root { color-scheme: dark; }
  body { margin: 0; background: #0d1220; color: #e8eaf0; font: 15px/1.55 -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; }
  .wrap { max-width: 1080px; margin: 0 auto; padding: 32px 20px 48px; }
  h1 { color: #ffd233; font-size: 22px; margin: 0 0 4px; }
  .sub { color: #9aa3bd; font-size: 13px; margin-bottom: 20px; }
  table { border-collapse: collapse; width: 100%; font-size: 14px; }
  th { text-align: left; color: #ffd233; border-bottom: 1px solid #2a3350; padding: 6px 8px; }
  td { border-bottom: 1px solid #1d2440; padding: 6px 8px; }
  .caveat { color: #9aa3bd; font-size: 12px; margin-top: 24px; }
</style>
</head>
<body>
<div class="wrap">
  <h1>Site Signal — scorecard</h1>
  <div class="sub">{{ ts }}</div>
  <table>
    <tr><th>Site</th><th>SEO</th><th>GEO</th><th>AEO</th><th>Overall</th><th>AI readiness</th><th>axe (c/s/m/m)</th><th>Trend</th></tr>
    {% for r in rows %}
    <tr>
      <td>{{ r.domain }}</td><td>{{ r.seo }}</td><td>{{ r.geo }}</td><td>{{ r.aeo }}</td>
      <td>{{ r.overall }}</td><td>{{ r.ai }}</td><td>{{ r.axe }}</td><td>{{ r.trend }}</td>
    </tr>
    {% endfor %}
  </table>
  {% for c in caveats %}<div class="caveat">{{ c }}</div>{% endfor %}
</div>
</body>
</html>
