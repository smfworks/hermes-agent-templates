# Site Signal site registry — EXAMPLE.
# Copy to ~/SiteSignal/sites.yaml and edit THERE. The real registry lives outside
# this profile so updates never overwrite it (SPEC.md 6.1).
# A fresh copy does not mark any domain owner_verified, and it does not auto-merge.
# Set owner_verified: true only after verify_ownership.sh exits 0 for repo,
# wellknown, or dns AND you confirm that domain yourself.
# Leave merge: ask unless you add merge_consent by hand. The agent must not
# write merge: after_green_ci or merge_consent.
sites:
  - domain: example.com
    aliases: [www.example.com]
    repo: OWNER/REPO
    default_branch: main
    deploy: unknown           # vercel | other | unknown
    owner_verified: false
    verified_by: ""           # repo | wellknown | dns, after you confirm
    scan:
      pages: 5                # SEO/GEO/AEO sampler
      axe_paths: ["/"]        # plus auto-discovered links, max 8
      mobile: false
    merge: ask                # ask | after_green_ci (after_green_ci needs merge_consent)
    notes: "Replace example.com and OWNER/REPO with a site you control."

# Standing auto-merge is off in this example. To allow it, you (not the agent)
# add a block that names the domain, who set it, and when:
#
#   merge: after_green_ci
#   merge_consent:
#     domain: example.com
#     phrase: "always merge green PRs for example.com"
#     set_by: your-name
#     set_at: "2026-01-01T00:00:00Z"
#
# Optional key for owned staging only: auth: staging
# Credentials come from .env or an owner-dropped cookie file, never from chat.
