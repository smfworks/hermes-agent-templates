# Site Signal (SMF Works) — copy to .env in the installed profile dir and fill in.
# Never commit .env. Prefer `gh auth login` (keyring) over GH_TOKEN in a file.
GH_TOKEN=
VERCEL_TOKEN=
CHROME_PATH=
XAI_API_KEY=
# gh binary override for scripts (ship_fix.sh, wait_deploy.sh, verify_ownership.sh).
# Set only if the default mise path is wrong on the host; never the ~/.local/bin/gh wrapper.
GH_BIN=
