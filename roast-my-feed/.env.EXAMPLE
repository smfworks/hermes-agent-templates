# Roast My Feed. Tokens do not belong in git.
# Copy to the installed profile .env with mode 0600. .env is gitignored.
#
# Placeholder — paste a key after the equals sign, no quotes:
XAI_API_KEY=
# If `hermes auth status xai-oauth` is already logged in, you can leave
# the placeholder empty.
#
# X API v2 app-only Bearer for live public reads (GET only).
# Prefer the Hermes secret store. Keep this value out of chat and out of logs.
X_BEARER_TOKEN=
