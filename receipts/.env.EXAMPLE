# Receipts. Tokens and app passwords do not belong in git.
# Copy to .env with mode 0600 if you must. .env is gitignored.
#
# Placeholder — paste a key after the equals sign, no quotes:
XAI_API_KEY=
# If `hermes auth status xai-oauth` is already logged in, you can leave
# the placeholder empty. Do not put mail bodies here.
#
# Gmail: a 0600 token file outside the repo, gmail.readonly only.
# GMAIL_TOKEN_PATH=
#
# IMAP: app password from the Hermes secrets store, mailbox opened read-only.
# IMAP_HOST=
# IMAP_USER=
# IMAP_PASSWORD=
